<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculator</title>
    <style>
        body { background: #0d1117; color: white; font-family: Arial, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .hidden { display: none !important; }
        
        /* Calculator Style */
        #calculator-screen { background: #161b22; padding: 20px; border-radius: 12px; width: 280px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        #calc-display { width: 100%; height: 50px; background: #010409; color: #58a6ff; font-size: 24px; text-align: right; padding: 10px; box-sizing: border-box; margin-bottom: 15px; border-radius: 6px; border: 1px solid #30363d; }
        .calc-buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
        .calc-btn { padding: 15px; font-size: 18px; background: #21262d; color: white; border: none; border-radius: 6px; cursor: pointer; }
        .calc-btn:active { background: #30363d; }
        .calc-btn.operator { background: #1f6feb; }

        /* Main Ghost Portal Style */
        #ghost-portal { width: 100%; height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; }
    </style>
</head>
<body>

    <!-- 1. FAKE CALCULATOR SCREEN -->
    <div id="calculator-screen">
        <div id="calc-display">0</div>
        <div class="calc-buttons">
            <button class="calc-btn" onclick="pressButton('C')">C</button>
            <button class="calc-btn" onclick="pressButton('(')">(</button>
            <button class="calc-btn" onclick="pressButton(')')">)</button>
            <button class="calc-btn operator" onclick="pressButton('/')">/</button>
            <button class="calc-btn" onclick="pressButton('7')">7</button>
            <button class="calc-btn" onclick="pressButton('8')">8</button>
            <button class="calc-btn" onclick="pressButton('9')">9</button>
            <button class="calc-btn operator" onclick="pressButton('*')">*</button>
            <button class="calc-btn" onclick="pressButton('4')">4</button>
            <button class="calc-btn" onclick="pressButton('5')">5</button>
            <button class="calc-btn" onclick="pressButton('6')">6</button>
            <button class="calc-btn operator" onclick="pressButton('-')">-</button>
            <button class="calc-btn" onclick="pressButton('1')">1</button>
            <button class="calc-btn" onclick="pressButton('2')">2</button>
            <button class="calc-btn" onclick="pressButton('3')">3</button>
            <button class="calc-btn operator" onclick="pressButton('+')">+</button>
            <button class="calc-btn" onclick="pressButton('0')">0</button>
            <button class="calc-btn" onclick="pressButton('.')">.</button>
            <button class="calc-btn operator" onclick="pressButton('=')">=</button>
            <button class="calc-btn operator" onclick="pressButton('')"></button>
        </div>
    </div>

    <!-- 2. GHOST TUNNEL MAIN APP -->
    <div id="ghost-portal" class="hidden">
        <h2>🔒 Ghost Tunnel Portal</h2>
        <p>Welcome to Secret Tunnel! (App unlocked successfully)</p>
        <!-- Yahan aap apna Room Name aur Password wala page load karwa sakte ho -->
    </div>

    <script>
        let inputSequence = "";
        // Aapka sequence: C -> 05001193024 -> C -> C -> =
        const targetSequence = "C05001193024CC=";

        function pressButton(val) {
            let display = document.getElementById("calc-display");

            // Agar user normal calculation kar raha hai jab tak secret sequence match nahi hui
            if (val === '=') {
                inputSequence += "=";
                checkSecret();
            } else if (val === 'C') {
                inputSequence += "C";
                display.innerText = "0";
                checkSecret();
            } else {
                inputSequence += val;
                display.innerText = inputSequence.replace(/C/g, ''); // Display se C hide rahega taaki pata na chale
            }
        }

        function checkSecret() {
            // Agar sequence match ho gayi
            if (inputSequence.includes(targetSequence)) {
                document.getElementById("calculator-screen").classList.add("hidden");
                document.getElementById("ghost-portal").classList.remove("hidden");
                return;
            }

            // Agar sequence bohot lambi ho gayi aur galat ho gayi toh reset kar do
            if (inputSequence.length > 25) {
                inputSequence = "";
                document.getElementById("calc-display").innerText = "0";
            }
        }
    </script>
</body>
</html>
